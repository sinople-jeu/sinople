---
// Une leçon publiée à distance : /lecon?id=<leçon>. Les leçons du site gardent leur page /quiz/<thème>/<étape>-<leçon>.
import Base from '../layouts/Base.astro';
import LeconDistante from '../islands/LeconDistante';
import '../styles/lecteur.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base titre="Leçon" nav={false}>
  <main class="page">
    <LeconDistante client:only="preact" base={base} />
  </main>
</Base>
