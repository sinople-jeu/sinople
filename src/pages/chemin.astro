---
// Le chemin d'un thème publié à distance (ajouté par le contenu distant, sans redéployer le site) : /chemin?id=<thème>.
// Les thèmes du site ont leur propre page (/theme/<id>) ; celle-ci se construit dans le navigateur à partir du manifeste.
import Base from '../layouts/Base.astro';
import Scene from '../components/Scene.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base titre="Chemin" fond="#191826" nuit>
  <main class="ecran" data-base={base}>
    <a class="retour icone-bouton" href={`${base}/`} aria-label="Revenir au choix des thèmes">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
    </a>
    <Scene mode="theme" actifDepuisUrl />
    <section class="texte">
      <h1 id="nom">Chemin</h1>
      <p class="grade" id="grade"></p>
    </section>
    <ol class="chemin" id="chemin"></ol>
    <p class="bientot" id="vide" hidden>Ce chemin arrive bientôt</p>
  </main>
</Base>

<script>
  import { contenuCourant } from '../lib/contenu/navigateur';
  import { lireEtat, stockageNavigateur } from '../lib/stockage/local';
  import { construireChemin } from '../lib/jeu/chemin';
  const racine = document.querySelector<HTMLElement>('.ecran')!;
  const base = racine.dataset.base!;
  const id = new URLSearchParams(location.search).get('id') ?? '';
  const m = contenuCourant();
  const t = m.themes.find((x) => x.id === id);
  if (!t) location.replace(`${base}/`);
  else {
    const etat = lireEtat(stockageNavigateur());
    const grade = etat.grades[t.id] ?? 1;
    document.title = `${t.nom} · Sinople`;
    document.getElementById('nom')!.textContent = t.nom;
    document.getElementById('grade')!.textContent = `Grade : ${t.grades[grade - 1]}`;
    const lecons = m.lecons.filter((l) => l.theme === t.id);
    const chemin = construireChemin(lecons, new Set(Object.keys(etat.leconsFaites)), grade);
    const liste = document.getElementById('chemin')!;
    for (const e of chemin.filter((e) => e.lecons.length || e.epreuve)) {
      const li = document.createElement('li');
      const h = document.createElement('h2');
      h.textContent = `Étape ${e.etape} · ${t.grades[e.etape - 1]}`;
      li.append(h);
      for (const x of [...e.lecons, ...(e.epreuve ? [e.epreuve] : [])]) {
        const l = lecons.find((y) => y.id === x.id)!;
        const a = document.createElement('a');
        a.className = `lecon ${x.etat}`;
        a.textContent = `${l.epreuve ? 'Épreuve' : l.lecon} · ${l.titre}`;
        if (x.etat !== 'verrouillee') a.href = `${base}/lecon?id=${encodeURIComponent(l.id)}`;
        else a.setAttribute('aria-disabled', 'true');
        li.append(a);
      }
      liste.append(li);
    }
    document.getElementById('vide')!.hidden = lecons.length > 0;
  }
</script>

<style>
  .ecran { min-height: 100dvh; color: var(--creme); text-align: center; position: relative; padding-bottom: 120px; }
  .retour { position: absolute; top: 8px; left: 8px; z-index: 1; color: var(--creme); background: rgb(25 24 38 / .6); }
  .texte { padding: 8px 16px; }
  .texte p { margin: 0; color: var(--or); }
  h1 { font-size: 2rem; margin: 0; }
  .chemin { list-style: none; max-width: 448px; margin: 0 auto; padding: 8px 16px; display: grid; gap: 20px; }
  .chemin :global(h2) { font: 1.05rem var(--police-texte); margin: 8px 0; padding: 8px 12px; border-radius: var(--arrondi); background: rgb(255 255 255 / .06); }
  .chemin :global(.lecon) { display: block; margin: 8px 0; padding: 12px; border-radius: var(--arrondi); background: var(--sinople); color: var(--creme); text-decoration: none; }
  .chemin :global(.lecon.faite) { background: var(--or); color: var(--encre); }
  .chemin :global(.lecon.verrouillee) { background: #3a3950; color: #8d8ba8; }
  .bientot { margin: 16px auto; }
  .bientot[hidden] { display: none; }
</style>
