---
// L'ancienne adresse du choix des quiz : c'est maintenant la page d'entrée.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${base}/`} />
    <link rel="canonical" href={`${base}/`} />
    <title>Sinople</title>
    <script is:inline define:vars={{ base }}>location.replace(`${base}/${location.search}`);</script>
  </head>
  <body><a href={`${base}/`}>Choisir un quiz</a></body>
</html>
