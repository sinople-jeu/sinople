---
// Classement : la ligue de la semaine (Sable, Gueules, Azur, Sinople, Pourpre, Argent, Or).
import Base from '../layouts/Base.astro';
import Classement from '../islands/Classement';
import '../styles/classement.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base titre="Classement">
  <main class="page">
    <Classement client:only="preact" base={base} />
  </main>
</Base>
