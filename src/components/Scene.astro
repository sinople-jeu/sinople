---
// Le bandeau de la scène du complot (environ un quart de l'écran), en pixel art.
// mode « accueil » : intro du renard, animaux venus au feu, tous éclairés.
// mode « theme » : le renard va voir l'animal du thème, seul éclairé ; les autres dans l'ombre, yeux jaunes.
// Les réglages (vitesses, durées) sont dans src/scene/reglages.ts ; le contenu dans src/data/scene.json.
import '../styles/scene.css';
interface Props { mode?: 'accueil' | 'theme'; actif?: string; /** Thème lu dans l'adresse (?id=…), pour les thèmes publiés à distance. */ actifDepuisUrl?: boolean }
const { mode = 'accueil', actif, actifDepuisUrl = false } = Astro.props;
---
<div class="scene-complot" data-mode={mode} data-actif={actif ?? ''} data-actif-url={actifDepuisUrl ? '1' : undefined}></div>

<script>
  import { monterScene } from '../scene/scene';
  import { contenuCourant, avecFichiersLocaux, verifierContenu } from '../lib/contenu/navigateur';
  // Le dernier contenu téléchargé (ou celui du site) ; le nouveau, s'il y en a, servira au prochain affichage.
  const m = await avecFichiersLocaux(contenuCourant());
  verifierContenu();
  for (const el of document.querySelectorAll<HTMLElement>('.scene-complot')) {
    monterScene(el, {
      mode: el.dataset.mode === 'theme' ? 'theme' : 'accueil',
      actif: el.dataset.actif || (el.dataset.actifUrl ? new URLSearchParams(location.search).get('id') : null),
      essaiRegne: new URLSearchParams(location.search).get('essai') === 'regne',
    }, m);
  }
</script>
